# Copie este arquivo para .env.local e preencha com os valores do Supabase
# de desenvolvimento. Peça os valores ao responsável pelo projeto, por
# mensagem privada. Nunca envie .env.local ao repositório.

# Endereço do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon), usada no login. O banco não aceita leitura nem
# gravação com ela.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta do Supabase (Project Settings > API Keys > Secret keys).
# Só no servidor, nunca no navegador. Dá acesso total aos dados e ignora a
# segurança por linha: trate como senha.
SUPABASE_SECRET_KEY=

# Segredo compartilhado com o GEDOC. O GEDOC envia os documentos de saída para
# POST /api/documentos com o cabeçalho "Authorization: Bearer <este valor>".
# Mínimo de 24 caracteres; gere um aleatório (ex.: openssl rand -hex 32) e use
# o mesmo valor em GEDOC_INTEGRATION_TOKEN no .env.local do GEDOC. Só no servidor.
GEDOC_INTEGRATION_TOKEN=
